{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar arquivo atual (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "preLaunchTask": "Compilar arquivo atual (gcc)"
    }
  ]
}
